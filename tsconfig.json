{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "lib": ["DOM", "ES2021"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "InfographicRenderer.tsx", "InfographicRemotionOverlay.tsx", "RemotionInfographicPreview.tsx", "data.ts", "out"]
}
